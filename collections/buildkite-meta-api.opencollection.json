{
  "opencollection": "1.0.0",
  "info": {
    "name": "Buildkite REST AccessToken Meta API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Meta",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Buildkite meta information",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.buildkite.com/v2/meta"
          },
          "docs": "Get Buildkite meta information"
        }
      ]
    }
  ],
  "bundled": true
}